# Copy to .env to override the defaults used by docker-compose.yml and scripts/.
# Local development only - never reuse these credentials anywhere real.
POSTGRES_USER=bookings
POSTGRES_PASSWORD=bookings_local_only
POSTGRES_DB=bookings
POSTGRES_PORT=5432
RESTORE_POSTGRES_PORT=5433

# Backups
BACKUP_DIR=./backups
BACKUP_KEEP=7
